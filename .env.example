# ---------------------------------------------------------------------------
# BUC Customer Service — environment configuration (copy to .env and edit).
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Public domain (used in tracking links and LINE Rich Menu URLs) and Nginx server_name
BUC_PUBLIC_BASE_URL=https://service.example.com
SERVER_NAME=service.example.com
HTTP_PORT=80
HTTPS_PORT=443

BUC_ENVIRONMENT=production
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BUC_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
BUC_COOKIE_SECURE=true

# PostgreSQL
POSTGRES_DB=buc_service
POSTGRES_USER=buc
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Sessions & login protection
BUC_SESSION_IDLE_MINUTES=60
BUC_SESSION_ABSOLUTE_HOURS=12
BUC_LOGIN_MAX_FAILURES=5
BUC_LOGIN_LOCKOUT_MINUTES=15

# Uploads (per file, MB)
BUC_MAX_UPLOAD_MB=10

# Application-level rate limits (Nginx applies additional limits)
BUC_RATE_LIMIT_SUBMIT_PER_HOUR=20
BUC_RATE_LIMIT_TRACK_PER_MINUTE=30
BUC_RATE_LIMIT_LOGIN_PER_MINUTE=10

# SMTP (leave BUC_SMTP_HOST empty to disable e-mail; notifications are then logged as SKIPPED)
BUC_SMTP_HOST=
BUC_SMTP_PORT=587
BUC_SMTP_USERNAME=
BUC_SMTP_PASSWORD=
BUC_SMTP_FROM=BUC Customer Service <no-reply@example.com>
BUC_SMTP_STARTTLS=true
BUC_SMTP_SSL=false

# LINE (optional, disabled when empty)
BUC_LINE_LOGIN_CHANNEL_ID=
BUC_LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# ERPNext (future — not used by this version)
BUC_ERPNEXT_BASE_URL=
BUC_ERPNEXT_API_KEY=
BUC_ERPNEXT_API_SECRET=
