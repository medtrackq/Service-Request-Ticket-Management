# BUC Customer Service - Nginx reverse proxy (HTTPS termination, static SPA, API proxy).
# Rendered by the nginx image's envsubst at start-up: ${SERVER_NAME} comes from the environment.

limit_req_zone $binary_remote_addr zone=buc_submit:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=buc_public:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=buc_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=buc_api:10m rate=20r/s;
limit_req_status 429;

upstream buc_api {
    server api:8000;
    keepalive 16;
}

server {
    listen 80;
    server_name ${SERVER_NAME};
    # ACME HTTP-01 challenge support (certbot --webroot -w /var/www/certbot)
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    # 10 images x 10 MB + form fields; the API enforces per-file limits itself.
    client_max_body_size 110m;
    client_body_timeout 120s;

    # Security headers live in a snippet because add_header in a location block
    # disables inheritance of server-level add_header directives.
    include /etc/nginx/snippets/security-headers.conf;

    root /usr/share/nginx/html;
    index index.html;

    location ~ /\. { deny all; }

    # ---- API -----------------------------------------------------------------
    location /api/ {
        limit_req zone=buc_api burst=40 nodelay;
        proxy_pass http://buc_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Overwrite (never append) so clients cannot spoof their IP for rate limiting/audit.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_request_buffering on;
    }
    location ~ ^/api/v1/public/requests/ {
        limit_req zone=buc_submit burst=5 nodelay;
        proxy_pass http://buc_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 180s;
    }
    location ~ ^/api/v1/public/track {
        limit_req zone=buc_public burst=20 nodelay;
        proxy_pass http://buc_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location = /api/v1/auth/login {
        limit_req zone=buc_login burst=5 nodelay;
        proxy_pass http://buc_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    # Interactive API docs are disabled by the API in production; never expose them publicly.
    location ~ ^/api/(docs|openapi\.json) { return 404; }

    # ---- SPA -----------------------------------------------------------------
    location /assets/ {
        expires 1y;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
